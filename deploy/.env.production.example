# Настройки для сервера. Скопируйте в .env.production рядом с docker-compose.yml.
# Пути к базе, снимкам и весам задаются в самом compose — здесь только то,
# что действительно зависит от площадки.

APP_NAME=BinGo API
DEBUG=false

# Распознавание. Требует файла весов — см. deploy/README.md.
# Поставьте stub, если хотите поднять сервис без модели.
CLASSIFIER=ml

# Детектор нужен только для уточнения названия предмета и скачивается сам
# при первом запуске (~6 МБ). Пустая строка отключает его и убирает
# лишние 100 мс с каждого запроса.
DETECTOR_WEIGHTS=yolov8n.pt
DETECTOR_CONFIDENCE=0.5

# Снимки пользователей: без них исправления категорий не превращаются
# в обучающую выборку. Это персональные данные — решение осознанное.
STORE_UPLOADS=true
UPLOADS_KEEP_DAYS=30

# Очки за сканирование.
POINTS_PER_SCAN=10
POINTS_FOR_NEW_CATEGORY=15

# Сколько процессов uvicorn. Каждый держит свою копию модели примерно
# на гигабайт, поэтому увеличивать стоит только вместе с памятью сервера.
WEB_CONCURRENCY=1
