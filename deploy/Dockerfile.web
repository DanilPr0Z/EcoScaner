# Фронтенд: собирается один раз, дальше отдаётся nginx как статика.
# Он же проксирует /api и /static на бэкенд — благодаря этому браузер видит
# один источник, и CORS в проде не нужен вовсе.

FROM node:22-slim AS build
WORKDIR /build

# Зависимости отдельным слоем — правки в коде не заставляют ставить их заново.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Служебные страницы (блок «что увидела нейросеть», страница «Модель») в проде
# скрыты: флаг не задан. Включаются пересборкой с VITE_SHOW_DEV_INFO=true.
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
