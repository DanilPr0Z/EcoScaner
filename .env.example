# Скопируйте в .env и правьте под себя. Все значения необязательные —
# без .env приложение работает на дефолтах из app/core/config.py.

APP_NAME=BinGo API
DEBUG=true

# SQLite рядом с проектом. Для Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/bingo
DATABASE_URL=sqlite+aiosqlite:///./bingo.db

# true — недостающие таблицы создаются при старте (удобно в разработке).
# Если ведёте схему через Alembic, поставьте false и накатывайте `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# stub — заглушка распознавания, ml — реальная модель (app/services/recognition/ml.py).
CLASSIFIER=stub

# Ограничение на загружаемое фото (файл не сохраняется, читается в память).
MAX_UPLOAD_BYTES=10485760

# Очки: за сканирование и бонус за впервые встреченную категорию.
POINTS_PER_SCAN=10
POINTS_FOR_NEW_CATEGORY=15
